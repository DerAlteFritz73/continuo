<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Basso Continuo Realizer{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.1em%22 font-size=%2296%22>𝄢</text></svg>">
    <style>
    /* ── Site nav: the one persistent way to move between Continuo, IMSLP and
       Reline. Sticky top bar, own dark surface distinct from any page's own
       body background, so it reads the same everywhere regardless of which
       section's local styles are loaded underneath it. #c8a96e gold accent /
       dark surface matches the palette all three sections already use. #}
    .site-nav{position:sticky;top:0;z-index:600;background:#12141c;border-bottom:1px solid #2a3244;
        box-shadow:0 2px 12px rgba(0,0,0,.35)}
    .site-nav-inner{max-width:1100px;margin:0 auto;padding:0 1.2rem;
        display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:52px}
    .site-nav-links{display:flex;gap:.3rem;flex-wrap:wrap}
    .site-nav-link{display:inline-flex;align-items:center;gap:.45rem;text-decoration:none;
        color:#8090a8;font-family:sans-serif;font-size:.85rem;font-weight:500;
        padding:.5rem .75rem;border-radius:7px;transition:color .15s,background .15s;white-space:nowrap}
    .site-nav-link:hover{color:#e8e4dc;background:rgba(200,169,110,.08)}
    .site-nav-link.active{color:#c8a96e;background:rgba(200,169,110,.12)}
    .site-nav-link .icon{font-size:1rem}

    /* Language switcher — a row of pills on a wide screen, a compact "FR ▾"
       menu on a phone. Lives inside the site nav now, so it no longer needs
       its own fixed positioning or the overlap workarounds that implies. */
    .lang-switcher{flex:0 0 auto}
    .lang-current{display:none}
    .lang-list{display:flex;gap:.2rem;flex-wrap:wrap;justify-content:flex-end}
    .lang-pill{font-size:.7rem;font-family:sans-serif;text-transform:uppercase;letter-spacing:.05em;color:#6a7a92;text-decoration:none;border:1px solid #2a3244;padding:.17rem .48rem;border-radius:4px;transition:color .15s,border-color .15s,background .15s;white-space:nowrap}
    .lang-pill:hover{color:#c8a96e;border-color:#c8a96e}
    .lang-pill.active{color:#c8a96e;border-color:#c8a96e;background:rgba(200,169,110,.12)}

    @media(max-width:640px){
        .site-nav-inner{padding:.5rem .8rem;min-height:auto}
        .site-nav-link{padding:.5rem .55rem;font-size:0}
        .site-nav-link .icon{font-size:1.15rem}
        .site-nav-link .label{display:none}

        .lang-current{display:inline-flex;align-items:center;gap:.3rem;list-style:none;cursor:pointer;
            font-size:.72rem;font-family:sans-serif;text-transform:uppercase;letter-spacing:.05em;
            color:#c8a96e;background:#161923;border:1px solid #2a3244;border-radius:6px;
            padding:.45rem .7rem;min-height:44px;user-select:none}
        .lang-current::-webkit-details-marker{display:none}
        .lang-chevron{font-size:.6rem;transition:transform .18s}
        .lang-switcher[open] .lang-chevron{transform:rotate(180deg)}
        .lang-list{display:none}
        .lang-switcher{position:relative}
        .lang-switcher[open] .lang-list{display:flex;flex-direction:column;gap:.25rem;
            position:absolute;top:calc(100% + .35rem);right:0;
            background:#161923;border:1px solid #2a3244;border-radius:8px;padding:.35rem;
            box-shadow:0 8px 24px rgba(0,0,0,.55)}
        /* Full 44 px touch targets inside the menu. */
        .lang-switcher[open] .lang-pill{display:flex;align-items:center;justify-content:center;
            min-width:56px;min-height:44px;font-size:.78rem;border-color:transparent}
    }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    {% set currentRoute = app.request.attributes.get('_route') %}
    <nav class="site-nav" aria-label="{{ 'nav.site_aria_label'|trans }}">
        <div class="site-nav-inner">
            <div class="site-nav-links">
                <a class="site-nav-link{% if currentRoute starts with 'app_imslp' %} active{% endif %}"
                   href="{{ path('app_imslp') }}"
                   {% if currentRoute starts with 'app_imslp' %}aria-current="page"{% endif %}>
                    <span class="icon" aria-hidden="true">⌕</span>
                    <span class="label">{{ 'nav.section_imslp'|trans }}</span>
                </a>
                <a class="site-nav-link{% if currentRoute starts with 'app_reline' %} active{% endif %}"
                   href="{{ path('app_reline') }}"
                   {% if currentRoute starts with 'app_reline' %}aria-current="page"{% endif %}>
                    <span class="icon" aria-hidden="true">𝄞</span>
                    <span class="label">{{ 'nav.section_reline'|trans }}</span>
                </a>
                <a class="site-nav-link{% if not (currentRoute starts with 'app_imslp' or currentRoute starts with 'app_reline') %} active{% endif %}"
                   href="{{ path('app_home') }}"
                   {% if not (currentRoute starts with 'app_imslp' or currentRoute starts with 'app_reline') %}aria-current="page"{% endif %}>
                    <span class="icon" aria-hidden="true">♩</span>
                    <span class="label">{{ 'nav.section_continuo'|trans }}</span>
                </a>
            </div>
            <details class="lang-switcher" aria-label="Language">
                <summary class="lang-current">
                    {{ app.request.locale|upper }}<span class="lang-chevron" aria-hidden="true">▾</span>
                </summary>
                <div class="lang-list">
                    {% for loc, label in {'en': 'EN', 'fr': 'FR', 'de': 'DE', 'cs': 'CS'} %}
                    <a class="lang-pill{% if app.request.locale == loc %} active{% endif %}"
                       href="{{ path('app_language', {locale: loc}) }}">{{ label }}</a>
                    {% endfor %}
                </div>
            </details>
        </div>
    </nav>
    {% block body %}{% endblock %}
</body>
</html>
